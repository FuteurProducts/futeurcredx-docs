# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# API URL (NestJS backend)
# When set, BFF client uses this as base URL with /dashboard prefix
# When not set, falls back to Supabase edge functions
VITE_API_URL=https://api.lumiq.futeurcredx.com/api/v1

# Supabase (legacy, used as fallback if VITE_API_URL not set)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
